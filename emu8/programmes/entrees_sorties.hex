; =====================================================================
;  entrees_sorties.hex  --  recopie les interrupteurs sur les LED
;
;  Boucle infinie : lit le port d'entree (0x81) et l'ecrit sur le port
;  de sortie (0x80). Le programme s'arrete quand les 8 interrupteurs
;  sont a 1 (valeur 0xFF).
;
;  A lancer avec l'option -e pour fixer les interrupteurs, par exemple :
;     emu8 entrees_sorties.hex -e 0x2A -c 200
;
;     0x00         JMP 0x04
;     0x02         RETI
;     0x04 debut:  LDI R7, 0xFF
;     0x06 boucle: LD  R0, 0x81     ; lecture des interrupteurs
;     0x08         ST  R0, 0x80     ; recopie sur les LED
;     0x0A         CMP R0, R7       ; tous les interrupteurs a 1 ?
;     0x0C         JZ  0x11
;     0x0E         JMP 0x06
;     0x11         HALT
;
;  ATTENDU avec -e 0x2A : LED = 00101010, puis limite de cycles.
;  ATTENDU avec -e 0xFF : LED = 11111111, puis HALT.
; =====================================================================

@00
50 04               ; JMP 0x04
78                  ; RETI

@04
0F FF               ; LDI R7, 0xFF
10 81               ; LD  R0, 0x81
18 80               ; ST  R0, 0x80
48 07               ; CMP R0, R7
58 11               ; JZ  0x11
50 06               ; JMP 0x06

@11
F8                  ; HALT
